<style>
    .btn-search {
        background-color: #fe424d;
        color: #fff;
        border-radius: 25px;
        padding: 0.5rem 1.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
    }

    .btn-search:hover {
        background-color: #fe424d;
        color: #fff;
    }

    .btn-search i {
        display: inline-block;
    }
    .search-inp{
        border-radius: 25px;
        padding:0.5rem 3rem 0.5rem 4rem;
    }
    .btn-clear{
        background-color: white;
        color: black;
        border:1px solid black;
        border-radius: 0.5rem;
        margin-left: -0.5rem;
    }
    .sort{
        background-color: white;
        color: black;
        border:1px solid black;
        border-radius: 0.5rem;
        margin-left: 0.5rem;
    }
    
        
</style>
<nav class="navbar navbar-expand-lg bg-white fixed-top">
    <div class="container-fluid">

        <a class="navbar-brand" href="/listing">
            <i class="fa-regular fa-compass"></i>
        </a>

        <!-- Hamburger button -->
        <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Collapsible navbar -->
        <div class="collapse navbar-collapse" id="navbarNav">

            <div class="navbar-nav">
                
                <a class="nav-link" href="/listing">Explore</a>
            </div>
            <div class="navbar-nav  ms-auto">
                <form class="d-flex" role="search" action="/listing/search" method="get">
                    <input
                        class="form-control me-2 search-inp"
                        type="search"
                        placeholder="Search destinations"
                        aria-label="Search"
                        name="q"
                        value="<%= typeof value !== 'undefined' ? value : '' %>"

                    />
                    <button class="btn btn-search" type="submit"> <i class="fa-solid fa-magnifying-glass"></i> Search</button>
                    <select name="sort" class="sort" onchange="this.form.submit()">
                        <option value="asc">Price: Low to High</option>
                        <option value="desc">Price: High to Low</option>
                    </select>
                </form>
                <form class="d-flex" action="/listing">
                        <button class="btn btn-clear"> Clear</button>
                </form>
                    


            </div>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/listing/new">Add New Listing</a>

                <% if(!currUser) { %>
                <a class="nav-link" href="/signup"><b>Sign up</b></a>
                <a class="nav-link" href="/login"><b>Log in</b></a>
                <% } %>
                <% if(currUser) { %>
                <a class="nav-link" href="/logout"><b>Log out</b></a>
                <% } %>
              </div>

        </div>
    </div>
</nav>
