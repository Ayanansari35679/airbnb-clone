<% layout("/layouts/boilerplate.ejs") %>

  <body>
    <div class="row">
      <div class="col-8 offset-2">
        <h3>Create a New Listing</h3>
        <form method="POST" action="/listing" data-bs-validate novalidate class="needs-validation" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="title" class="from-label">Title</Title></label>
            <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required />
            <div class="valid-feedback">Its a good title</div>  
          </div>
          <div class="mb-3">
            <label for="description" class="from-label">description</label>
            <textarea name="listing[description]" placeholder="enter description" class="form-control" required></textarea>
            <div class="invalid-feedback">Enter a valid short description</div>  

          </div>

          <div class="mb-3">
            <label for="image" class="form-label">Upload Listing Image</label>
            <input name="listing[image]"  type="file" class="form-control" required  />
            
          </div>
          <div class="row">
            <div class="mb-3 col-md-4">
              <div class="mb-3">
                <label for="category" class="form-label">Category</label>

                <select name="listing[category]" id="category" class="form-select" required>
                    <option value="" selected disabled>Select Category</option>
                    <option value="Apartments">Apartments</option>
                    <option value="Houses">Houses</option>
                    <option value="Mountains">Mountains</option>
                    <option value="Beachfront">Beachfront</option>
                    <option value="Tropical">Tropical</option>
                    <option value="Castles">Castles</option>
                    <option value="Camping">Camping</option>
                    <option value="Arctic">Arctic</option>
                    <option value="Amazing Pools">Amazing Pools</option>
                    <option value="Countryside">Countryside</option>
                    <option value="Luxury">Luxury</option>
                    <option value="Farm Stays">Farm Stays</option>
                    <option value="Lakefront">Lakefront</option>
                    <option value="Trending">Trending</option>
                </select>
            </div>
            </div>
          </div>
          

          <div class="row">
            <div class="mb-3 col-md-4">
              <div class="mb-3">
                <label for="price" class="form-label">price</label>
                <input name="listing[price]" placeholder="enter price" class="form-control" required/>
                <div class="invalid-feedback">Enter valid price</div>  
                
              </div>
              <div class="mb-3 col-md-8">
                <label for="country" class="form-label">country</label>
                <input name="listing[country]" placeholder="enter country" type="text" class="form-control" required />
                <div class="invalid-feedback">Enter the country name</div>  

              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required/>
            <div class="invalid-feedback">Enter the location </div>  

          </div>

          <br /><br />
          <button>Add</button>
        </form>
      </div>

    </div>
    <!-- <button class="btn btn-dark add-btn">edit</button> -->
    

  </body>