<% layout("/layouts/boilerplate.ejs") %>

    <body>
        <div class="row mt-3">
            <div class="col-8 offset-2">
                <h3>Edit your Listing</h3>
                <form
                    method="POST"
                    action="/listing/<%= listing._id %>?_method=PUT"
                    enctype="multipart/form-data"
                    data-bs-validate
                    novalidate
                    class="needs-validation"
                >
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required/>
                        <div class="invalid-feedback">Enter a valid <Title</TItle></div>  
   
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">description</label>
                        <textarea name="listing[description]" class="form-control" required>
                    <%= listing.description %></textarea>
                        <div class="invalid-feedback">Enter a valid short description</div>  
                    </div>

                    <div class="mb-3">
                        Original Listing Image <br>
                        <img src="<%=originalImageUrl%>" width="200" height="200">
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">Upload New Image</label>
                        <input
                            name="listing[image]"
                            id="image"
                            class="form-control"
                            type="file"
                            accept="image/*"
                        />
                        <div class="invalid-feedback">
                            Please upload a valid image.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select name="listing[category]" id="category" class="form-select" required>
                            <option value="Trending" <%= listing.category === "Trending" ? "selected" : "" %>>Trending</option>
                            <option value="Apartments" <%= listing.category === "Apartments" ? "selected" : "" %>>Apartments</option>
                            <option value="Houses" <%= listing.category === "Houses" ? "selected" : "" %>>Houses</option>
                            <option value="Mountains" <%= listing.category === "Mountains" ? "selected" : "" %>>Mountains</option>
                            <option value="Beachfront" <%= listing.category === "Beachfront" ? "selected" : "" %>>Beachfront</option>
                            <option value="Tropical" <%= listing.category === "Tropical" ? "selected" : "" %>>Tropical</option>
                            <option value="Castles" <%= listing.category === "Castles" ? "selected" : "" %>>Castles</option>
                            <option value="Camping" <%= listing.category === "Camping" ? "selected" : "" %>>Camping</option>
                            <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
                            <option value="Amazing Pools" <%= listing.category === "Amazing Pools" ? "selected" : "" %>>Amazing Pools</option>
                            <option value="Countryside" <%= listing.category === "Countryside" ? "selected" : "" %>>Countryside</option>
                            <option value="Luxury" <%= listing.category === "Luxury" ? "selected" : "" %>>Luxury</option>
                            <option value="Farm Stays" <%= listing.category === "Farm Stays" ? "selected" : "" %>>Farm Stays</option>
                            <option value="Lakefront" <%= listing.category === "Lakefront" ? "selected" : "" %>>Lakefront</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input name="listing[price]" class="form-control" value="<%= listing.price %>"
                                type="number" required />
                            <div class="invalid-feedback">Enter a valid price</div> 

                        </div>

                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input name="listing[country]" class="form-control" value="<%= listing.country %>"
                                type="text" required />
                            <div class="invalid-feedback">Enter the valid country name</div>  

                        </div>
                    </div>


                    <div class="mb-3">
                        <label for="location" class="form-label">location</label>
                        <input name="listing[location]" class="form-control" value="<%= listing.location %>"
                            type="text" required/>
                        <div class="invalid-feedback">Enter a valid location</div>  

                    </div>

                    <br /><br />
                    <button class="btn edit-btn mt-3">Edit</button>
                </form>
            </div>
        </div>

    </body>

    </html>